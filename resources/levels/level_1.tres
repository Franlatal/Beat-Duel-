[gd_resource type="Resource" script_class="LevelData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/LevelData.gd" id="1_leveldata"]
[ext_resource type="Script" path="res://scripts/DifficultyOption.gd" id="2_diffopt"]
[ext_resource type="PackedScene" path="res://scenes/levels/Level1.tscn" id="3_scene"]

[sub_resource type="Resource" script_class="DifficultyOption" id="DifficultyOption_l1_easy"]
script = ExtResource("2_diffopt")
label = "Easy"
track_name = "EasySingle"
lane_count = 2

[sub_resource type="Resource" script_class="DifficultyOption" id="DifficultyOption_l1_normal"]
script = ExtResource("2_diffopt")
label = "Normal"
track_name = "MediumSingle"
lane_count = 3

[sub_resource type="Resource" script_class="DifficultyOption" id="DifficultyOption_l1_hard"]
script = ExtResource("2_diffopt")
label = "Hard"
track_name = "ExpertSingle"
lane_count = 4

[resource]
script = ExtResource("1_leveldata")
id = &"level_1"
title = "Level 1"
artist = "Unknown Artist"
difficulties = Array[DifficultyOption]([SubResource("DifficultyOption_l1_easy"), SubResource("DifficultyOption_l1_normal"), SubResource("DifficultyOption_l1_hard")])
default_difficulty_index = 2
bpm = 160.0
description = "First real track."
level_scene = ExtResource("3_scene")
unlocked = true
